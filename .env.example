APP_NAME="Smartoh Technologies ISP Billing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=smart_billing
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="billing@smartoh.net"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# SMARTOH NON-CUSTODIAL PAYMENT & NETWORK ORCHESTRATION CONFIGURATION
# ==============================================================================
# Note: Individual ISP tenant payment credentials (Daraja Paybill/Till, Pesapal,
# PayPal, Bank IPNs) are stored encrypted per-tenant in `payment_gateways` and
# NEVER pooled into a Smartoh-owned account.
# The variables below configure platform-level defaults, webhook rate-limiting,
# and Smartoh's separate SaaS subscription billing gateway.

SMARTOH_NON_CUSTODIAL_ENFORCED=true
SMARTOH_WEBHOOK_RATE_LIMIT_PER_MIN=120
SMARTOH_ACTIVATION_MAX_ATTEMPTS=5
SMARTOH_ACTIVATION_BASE_BACKOFF_SEC=15

# Smartoh SaaS Platform Subscription Collection (Strictly separate from ISP subscriber collections)
SMARTOH_SAAS_MPESA_ENV=sandbox
SMARTOH_SAAS_MPESA_SHORTCODE=174379
SMARTOH_SAAS_MPESA_CONSUMER_KEY=
SMARTOH_SAAS_MPESA_CONSUMER_SECRET=
SMARTOH_SAAS_MPESA_PASSKEY=

# Default RouterOS & RADIUS CoA Timeouts
SMARTOH_ROUTEROS_API_TIMEOUT_SEC=3
SMARTOH_RADIUS_COA_PORT=3799

# ==============================================================================
# KENYA GIS FIBER MAP & GEOSPATIAL CONFIGURATION (EPSG:4326 / WGS 84)
# ==============================================================================
SMARTOH_MAP_DEFAULT_LAT=0.0236
SMARTOH_MAP_DEFAULT_LNG=37.9062
SMARTOH_MAP_DEFAULT_ZOOM=6
SMARTOH_MAP_TILE_URL_DARK="https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png"
SMARTOH_MAP_TILE_URL_STREET="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
SMARTOH_MAP_TILE_URL_TOPO="https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png"
SMARTOH_MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap contributors &copy; CARTO"
SMARTOH_GEOCODER_ENABLED=true
SMARTOH_GEOCODER_URL="https://nominatim.openstreetmap.org/search"
SMARTOH_GEOCODER_API_KEY=
SMARTOH_GEOCODER_COUNTRY_CODES=ke
SMARTOH_GEOCODER_USER_AGENT="SmartohTechnologiesISPBilling/2.4 (noc@smartoh.net)"
SMARTOH_GEOCODER_CACHE_TTL_HOURS=72
SMARTOH_GEOCODER_RATE_LIMIT_PER_MIN=30

VITE_APP_NAME="${APP_NAME}"
